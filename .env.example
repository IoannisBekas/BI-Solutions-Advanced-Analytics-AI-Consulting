PORT=5001
APP_URL=https://www.bisolutions.group
VITE_QUANTUS_URL=/quantus/workspace/
QUANTUS_API_TARGET=http://127.0.0.1:3001
PYTHON_API_URL=http://127.0.0.1:8000
PYTHON_API_HOST=127.0.0.1

# Security - required in production
JWT_SECRET=
ALLOWED_ORIGINS=https://www.bisolutions.group,https://bisolutions.group
QUANTUS_INTERNAL_KEY=
QUANTUS_PYTHON_TIMEOUT_MS=90000
TRUST_PROXY_HOPS=1

# Database - SQLite file location (default: ./data)
# On Railway, mount a volume and set DATA_DIR to the mount path
DATA_DIR=

# Contact form (Resend email service).
# Only used when the Express server is actually deployed. CONTACT_RECIPIENT_EMAIL
# is required — there is no default, so the destination mailbox never lands in
# the repository.
RESEND_API_KEY=
CONTACT_RECIPIENT_EMAIL=
CONTACT_FROM_EMAIL=

# Static hosting (GitHub Pages) cannot run the Express route above. Point this
# at a form service endpoint (Formspree, Web3Forms) and the brief form posts
# there instead. Leave empty to use /api/contact.
VITE_CONTACT_ENDPOINT=

# AI Learning digital products: full PDF access by email, served by Express.
# Reuses RESEND_API_KEY above. Set a verified sender; CONTACT_FROM_EMAIL is the
# fallback only when explicitly configured. APP_URL is the public website URL
# for recovery links. For a separate API host, set AI_LEARNING_API_URL to that
# trusted backend origin for PDF download links.
AI_LEARNING_FROM_EMAIL=
AI_LEARNING_API_URL=
# Optional frontend build-time API origin when using a separate backend host.
VITE_AI_LEARNING_API_URL=
# Private SQLite directory for ai-learning.db. Defaults to DATA_DIR (or ./data).
# May use its own persistent volume, independently of the main users database.
AI_LEARNING_DATA_DIR=
# Private directory with English/ and Greek/ subfolders. Default:
# <DATA_DIR>/ai-learning-pdfs (or ./data/ai-learning-pdfs).
AI_LEARNING_PDF_DIR=

# Project deposits via Revolut Hosted Checkout. Keep credentials on the server.
# Sandbox and production use separate API keys and should use different token secrets.
PROJECT_DEPOSIT_REVOLUT_ENV=sandbox
PROJECT_DEPOSIT_REVOLUT_API_KEY=
# Optional Orders Write key for the issuance command. The web server only needs Orders Read.
PROJECT_DEPOSIT_REVOLUT_ISSUER_KEY=
# Generate a dedicated random value of at least 32 characters.
PROJECT_DEPOSIT_TOKEN_SECRET=
# Public site origin for issued links. HTTP loopback is allowed only in Sandbox.
PROJECT_DEPOSIT_ORIGIN=

# Public one-off payments through Revolut's embedded checkout.
DIRECT_PAYMENTS_ENABLED=false
DIRECT_PAYMENTS_REVOLUT_ENV=sandbox
DIRECT_PAYMENTS_REVOLUT_PUBLIC_KEY=
# Server-side Merchant API key with Orders Write.
DIRECT_PAYMENTS_REVOLUT_API_KEY=
# Generate a separate random secret of at least 32 characters.
DIRECT_PAYMENTS_TOKEN_SECRET=
# Use a persistent volume for the checkout attempt database in production.
DIRECT_PAYMENTS_DATA_DIR=

# Customer-entered automatic monthly payments (sandbox or production).
RECURRING_PAYMENTS_ENABLED=false
RECURRING_PAYMENTS_REVOLUT_ENV=sandbox
# Matching Merchant key with Customers Write, Subscriptions Write and Orders Read.
RECURRING_PAYMENTS_REVOLUT_API_KEY=
RECURRING_PAYMENTS_TOKEN_SECRET=
RECURRING_PAYMENTS_DATA_DIR=

# Bonusaki production pilot
# Keep disabled until a merchant pilot is ready and cashier/admin controls are set.
BONUSAKI_PILOT_ENABLED=false
# At least 32 characters; dedicated secret preferred.
BONUSAKI_TOKEN_SECRET=
# Optional but recommended; at least 32 characters to sign generated QR URLs.
BONUSAKI_QR_SECRET=
# Set true after regenerating a signed QR batch.
BONUSAKI_REQUIRE_SIGNED_QR=false
BONUSAKI_CASHIER_PIN=
# At least 24 characters.
BONUSAKI_ADMIN_KEY=

# AI API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
POWERBI_SOLUTIONS_ANTHROPIC_API_KEY=
GEMINI_API_KEY=
FMP_API_KEY=
SEC_EDGAR_USER_AGENT=QuantusResearchSolutions/2.4 https://www.bisolutions.group
GOOGLE_CLIENT_ID=

# Quantus cache + scanner
SCREENER_SEED_TICKERS=NVDA,TSLA,BTC,SPY,GLD,ASST,AAPL,MSFT,AMZN,GOOGL
